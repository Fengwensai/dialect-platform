# 复制为 .env 并修改（.env 含真实凭据，已 gitignore，绝不提交/外发）

# —— 数据库（PostgreSQL）——
DATABASE_URL=postgresql+psycopg://dialect:CHANGE_ME@localhost:5432/dialect_admin
# JWT 签名密钥：用任意长随机串，如 openssl rand -hex 32
JWT_SECRET=please-generate-a-long-random-secret
# 管理后台登录态有效期（分钟）
JWT_EXPIRE_MINUTES=720
# 种子管理员初始密码（init_db.py 建 admin/hebei_admin 用；后台无改密接口，上线务必设强密码再建）
ADMIN_INIT_PASSWORD=admin123

# —— 微信小程序凭据（mp.weixin.qq.com 小程序后台获取）——
WECHAT_APPID=your_appid
WECHAT_SECRET=your_app_secret

# —— 上线相关（可选，开发留空）——
# 录音文件公网访问前缀（https://你的域名），非 COS 模式时供微信内容安全下载用
MEDIA_PUBLIC_BASE=
# CORS 白名单，逗号分隔；开发默认 *，上线收紧为后台前端域名
CORS_ORIGINS=*
# 录音文件大小上限（MB），与微信 media_check_async 上限对齐
MAX_RECORDING_SIZE_MB=10
# 微信「消息推送」验签 Token（mp 后台 开发→开发设置→消息推送 配置，明文模式）
WECHAT_MSG_TOKEN=

# —— 腾讯云 COS（录音对象存储，私有桶+预签名，服务器中转）——
# 四项全填才启用 COS；任一项为空则录音落本地磁盘（MEDIA_ROOT）兜底。
# COS_BUCKET 形如 "桶名-appid"（必须含 APPID 后缀）；COS_REGION 如 "ap-beijing"
COS_SECRET_ID=
COS_SECRET_KEY=
COS_REGION=
COS_BUCKET=
# 录音等媒体文件本地根目录（头像仍存这里；未配 COS 时录音也存这里）
MEDIA_ROOT=

# —— 限流（进程内固定窗口；防爆破/防刷，按需调）——
# 登录：连续 LOGIN_FAIL_LIMIT 次失败后锁定 LOGIN_FAIL_WINDOW_SECONDS 秒（账号/IP 各一份，成功即清零）
LOGIN_FAIL_LIMIT=5
LOGIN_FAIL_WINDOW_SECONDS=900
LOGIN_IP_FAIL_LIMIT=20
# 上传：单个发音人 UPLOAD_RATE_LIMIT 次 / UPLOAD_RATE_WINDOW_SECONDS 秒
UPLOAD_RATE_LIMIT=60
UPLOAD_RATE_WINDOW_SECONDS=600
