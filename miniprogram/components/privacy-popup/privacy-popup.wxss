/* 隐私授权弹窗（复用 login 页 bind-mask 视觉语言：遮罩 + 圆角 dialog） */
.privacy-mask {
  position: fixed;
  left: 0;
  top: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.5);
  z-index: 2000;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 0 56rpx;
  box-sizing: border-box;
}

.privacy-dialog {
  width: 100%;
  max-width: 600rpx;
  background: #fff;
  border-radius: 24rpx;
  padding: 48rpx 40rpx 32rpx;
  box-sizing: border-box;
}

.privacy-title {
  font-size: 36rpx;
  font-weight: 700;
  color: #303133;
  text-align: center;
}

.privacy-desc {
  font-size: 24rpx;
  color: #909399;
  line-height: 1.6;
  margin-top: 16rpx;
  text-align: center;
}

.privacy-link {
  color: #2b6cb0;
}

.privacy-btn {
  width: 100%;
  height: 88rpx;
  line-height: 88rpx;
  font-size: 30rpx;
  border-radius: 999rpx;
  margin-top: 24rpx;
  padding: 0;
}

.privacy-btn::after {
  border: none;
}

.privacy-btn.agree {
  background: linear-gradient(135deg, #2b6cb0, #4299e1);
  color: #fff;
}

.privacy-btn.refuse {
  background: #f0f2f5;
  color: #606266;
}
