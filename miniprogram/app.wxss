/* 全局样式 */
page {
  background: #f5f6f7;
  font-size: 28rpx;
  color: #303133;
  box-sizing: border-box;
}

/* 卡片统一外观：白底 · 16rpx 圆角 · 轻微投影（全站风格一致） */
view.card,
view.hero,
view.head,
view.stat-card,
view.profile-card,
view.review-card,
view.filter,
view.task-card,
view.word,
view.item,
view.recorder-box,
view.hint,
view.select-toolbar {
  box-shadow: 0 2rpx 12rpx rgba(45, 55, 72, 0.06);
}

.btn-primary {
  background: #2b6cb0;
  color: #fff;
  border-radius: 12rpx;
}

.btn-ghost {
  background: #fff;
  color: #2b6cb0;
  border: 1rpx solid #2b6cb0;
  border-radius: 12rpx;
}

.btn-danger {
  background: #e53e3e;
  color: #fff;
  border-radius: 12rpx;
}

.small {
  font-size: 26rpx;
  padding: 0 24rpx;
  line-height: 2.4;
}
