.page {
  min-height: 100vh;
  box-sizing: border-box;
  display: flex;
  flex-direction: column;
  padding: 0 64rpx;
  background: linear-gradient(180deg, #2b6cb0 0%, #4299e1 42%, #f5f6f7 42.1%);
}

.brand {
  margin-top: 220rpx;
  text-align: center;
  color: #fff;
}

.brand-compact {
  margin-top: 120rpx;
}

.brand-logo {
  width: 140rpx;
  height: 140rpx;
  line-height: 140rpx;
  margin: 0 auto 32rpx;
  background: rgba(255, 255, 255, 0.18);
  border: 2rpx solid rgba(255, 255, 255, 0.5);
  border-radius: 32rpx;
  font-size: 72rpx;
  font-weight: 700;
  color: #fff;
}

.brand-title {
  font-size: 44rpx;
  font-weight: 600;
}

.brand-sub {
  font-size: 26rpx;
  opacity: 0.85;
  margin-top: 12rpx;
  line-height: 1.6;
  padding: 0 24rpx;
}

.agree-card {
  margin-top: 140rpx;
  background: #fff;
  border-radius: 16rpx;
  padding: 28rpx 32rpx;
  box-shadow: 0 2rpx 12rpx rgba(45, 55, 72, 0.06);
}

.agree-title {
  font-size: 24rpx;
  color: #909399;
  line-height: 1.6;
  margin-bottom: 8rpx;
}

.agree-row {
  display: flex;
  align-items: center;
  padding: 24rpx 16rpx;
  border-radius: 10rpx;
  border-bottom: 1rpx solid #f0f1f3;
}

.agree-row:last-of-type {
  border-bottom: none;
}

.agree-row-checked {
  background: #f0f7ff;
}

.agree-row-hover {
  background: #f0f7ff;
}

.agree-check {
  width: 40rpx;
  height: 40rpx;
  flex-shrink: 0;
  border: 2rpx solid #c0c4cc;
  border-radius: 50%;
  background: #fff;
  box-sizing: border-box;
  display: flex;
  align-items: center;
  justify-content: center;
}

.agree-check-on {
  background: #2b6cb0;
  border-color: #2b6cb0;
}

.agree-check-mark {
  font-size: 24rpx;
  color: #fff;
  line-height: 1;
}

.agree-row-text {
  flex: 1;
  font-size: 28rpx;
  color: #2b6cb0;
  margin-left: 20rpx;
  text-decoration: underline;
}

.agree-status {
  padding: 40rpx 0 24rpx;
  text-align: center;
  font-size: 26rpx;
  color: #909399;
}

.agree-retry {
  padding-bottom: 32rpx;
  text-align: center;
  font-size: 26rpx;
  color: #2b6cb0;
  text-decoration: underline;
}

.login-btn {
  margin-top: 48rpx;
  font-size: 32rpx;
  line-height: 2.8;
  border-radius: 999rpx;
}

.login-btn::after {
  border: none;
}

.login-tip {
  margin-top: 24rpx;
  text-align: center;
  font-size: 24rpx;
  color: #909399;
}

/* 头像仅本地缓存提示（隐私合规：不存储于服务器） */
.avatar-note {
  width: 100%;
  margin-top: 20rpx;
  font-size: 22rpx;
  line-height: 1.6;
  color: #909399;
  text-align: center;
}

/* —— 登录后：完善头像昵称 —— */
.setup-card {
  margin-top: 96rpx;
  background: #fff;
  border-radius: 16rpx;
  padding: 48rpx 40rpx 40rpx;
  box-shadow: 0 2rpx 12rpx rgba(45, 55, 72, 0.06);
  display: flex;
  flex-direction: column;
  align-items: center;
}

.avatar-btn {
  margin: 0;
  padding: 0;
  background: transparent;
  border: none;
  line-height: 1;
  width: 160rpx;
}

.avatar-btn::after {
  border: none;
}

.avatar {
  width: 160rpx;
  height: 160rpx;
  border-radius: 50%;
  border: 3rpx solid #4299e1;
  box-sizing: border-box;
}

.avatar-placeholder {
  display: flex;
  align-items: center;
  justify-content: center;
  background: #edf2f7;
  color: #a0aec0;
  font-size: 52rpx;
  font-weight: 700;
}

.avatar-edit {
  text-align: center;
  font-size: 22rpx;
  color: #909399;
  margin-top: 12rpx;
}

.nickname-input {
  width: 100%;
  height: 88rpx;
  margin-top: 32rpx;
  padding: 0 28rpx;
  box-sizing: border-box;
  background: #f5f6f7;
  border-radius: 12rpx;
  font-size: 28rpx;
  color: #303133;
}

.nickname-placeholder {
  color: #a0aec0;
}

.profile-block {
  width: 100%;
  margin-top: 16rpx;
}

.profile-title {
  font-size: 24rpx;
  color: #909399;
  text-align: left;
  padding: 8rpx 4rpx 0;
}

.team-code-input {
  width: 420rpx;
  height: 64rpx;
  padding: 0 20rpx;
  box-sizing: border-box;
  background: #f5f6f7;
  border-radius: 10rpx;
  font-size: 28rpx;
  color: #303133;
  text-align: right;
}

.form-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 24rpx 4rpx;
  border-bottom: 1rpx solid #f0f1f3;
}

.form-row:last-of-type {
  border-bottom: none;
}

.form-label {
  font-size: 28rpx;
  color: #303133;
}

.picker-value {
  font-size: 28rpx;
  color: #2b6cb0;
}

.picker-placeholder {
  color: #a0aec0;
}

.save-btn {
  width: 100%;
  margin-top: 32rpx;
  font-size: 30rpx;
  border-radius: 12rpx;
}

.skip-btn {
  width: 100%;
  margin-top: 20rpx;
  font-size: 28rpx;
  border-radius: 12rpx;
}

/* —— 协议确认弹窗（自定义 modal） —— */
.bind-mask {
  position: fixed;
  left: 0;
  top: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.5);
  z-index: 1000;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 0 56rpx;
  box-sizing: border-box;
}

.agree-dialog {
  width: 100%;
  max-width: 600rpx;
  background: #fff;
  border-radius: 24rpx;
  padding: 48rpx 40rpx 32rpx;
  box-sizing: border-box;
}

.bind-dialog-title {
  font-size: 36rpx;
  font-weight: 700;
  color: #303133;
  text-align: center;
}

.bind-dialog-desc {
  font-size: 24rpx;
  color: #909399;
  line-height: 1.6;
  margin-top: 16rpx;
  text-align: center;
}

.agree-dialog-list {
  margin-top: 28rpx;
}

.agree-dialog-item {
  display: flex;
  align-items: center;
  padding: 20rpx 8rpx;
  border-bottom: 1rpx solid #f0f1f3;
}

.agree-dialog-name {
  flex: 1;
  font-size: 28rpx;
  color: #303133;
}

.agree-dialog-version {
  font-size: 24rpx;
  color: #909399;
  margin-right: 24rpx;
}

.agree-dialog-link {
  font-size: 26rpx;
  color: #2b6cb0;
}

.bind-dialog-actions {
  display: flex;
  gap: 20rpx;
  margin-top: 40rpx;
}

.bind-dialog-btn {
  flex: 1;
  height: 88rpx;
  line-height: 88rpx;
  font-size: 30rpx;
  border-radius: 999rpx;
  margin: 0;
  padding: 0;
}

.bind-dialog-btn::after {
  border: none;
}

.bind-dialog-btn.cancel {
  background: #f0f2f5;
  color: #606266;
}

.bind-dialog-btn.confirm {
  background: linear-gradient(135deg, #2b6cb0, #4299e1);
  color: #fff;
}

.bind-dialog-btn.confirm[disabled] {
  opacity: 0.6;
}
