.page {
  padding: 32rpx;
}

.toolbar {
  display: flex;
  gap: 20rpx;
  margin-bottom: 24rpx;
}

.select-toolbar {
  background: #fff;
  border-radius: 16rpx;
  padding: 20rpx;
}

/* 本轮5 本地存储占用提示 */
.storage-line {
  font-size: 24rpx;
  color: #909399;
  margin-bottom: 16rpx;
}

.list {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.item {
  background: #fff;
  border-radius: 16rpx;
  padding: 28rpx;
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
}

.item.checked {
  background: #f0f7ff;
  border: 1rpx solid #4299e1;
}

/* 选择模式勾选 */
.check {
  flex-shrink: 0;
  margin-right: 20rpx;
  padding-top: 4rpx;
}

.check-box {
  width: 40rpx;
  height: 40rpx;
  border-radius: 50%;
  border: 2rpx solid #c0c4cc;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 24rpx;
  color: #fff;
  box-sizing: border-box;
}

.check-box.on {
  background: #2b6cb0;
  border-color: #2b6cb0;
}

.item-main {
  flex: 1;
  margin-right: 20rpx;
  min-width: 0;
}

.item-content {
  font-size: 32rpx;
  font-weight: 600;
  color: #303133;
}

.item-meta {
  font-size: 24rpx;
  color: #909399;
  margin-top: 8rpx;
}

.item-error {
  font-size: 22rpx;
  color: #e53e3e;
  margin-top: 8rpx;
  word-break: break-all;
}

.item-side {
  text-align: right;
  flex-shrink: 0;
}

.status {
  display: inline-block;
  font-size: 22rpx;
  padding: 4rpx 16rpx;
  border-radius: 999rpx;
}

.status-pending {
  background: #edf2f7;
  color: #718096;
}

.status-uploading {
  background: #fefcbf;
  color: #975a16;
}

.status-done {
  background: #c6f6d5;
  color: #276749;
}

.status-error {
  background: #fed7d7;
  color: #c53030;
}

.status-claimLost {
  background: #fdeaea;
  color: #c53030;
}

.ops {
  margin-top: 16rpx;
}

.op {
  font-size: 24rpx;
  color: #2b6cb0;
  margin-left: 24rpx;
}

.op-danger {
  color: #e53e3e;
}

.empty {
  text-align: center;
  color: #a0aec0;
  padding: 120rpx 0;
  font-size: 28rpx;
}
