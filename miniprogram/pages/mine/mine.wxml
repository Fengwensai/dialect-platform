<view class="page">
  <!-- 用户信息卡（头像/姓名/方言点/个人信息 汇总，点击进入编辑页） -->
  <view class="user-card" bindtap="goProfile" hover-class="user-card-hover">
    <image class="avatar" wx:if="{{displayAvatarUrl}}" src="{{displayAvatarUrl}}" mode="aspectFill" />
    <view class="avatar avatar-placeholder" wx:else>方</view>
    <view class="user-info">
      <view class="user-name">{{nickname || '微信用户'}}</view>
      <view class="user-line">所属地区：{{provinceName || '未加入团队'}}</view>
      <view class="user-line">个人信息：{{profileText || '未填写'}}</view>
    </view>
    <view class="edit-badge">编辑 ›</view>
  </view>

  <!-- 常用功能（卡片点击） -->
  <view class="card">
    <view class="section-title">常用功能</view>
    <view class="func-cell" bindtap="goQueue">
      <view class="func-icon func-icon-queue">列</view>
      <view class="func-info">
        <view class="func-title">录音队列</view>
        <view class="func-sub">本地 {{stats.total}} 条 · 待上传 {{stats.pending}}</view>
      </view>
      <view class="func-arrow">›</view>
    </view>
    <view class="func-cell" bindtap="onUploadAll">
      <view class="func-icon func-icon-upload">传</view>
      <view class="func-info">
        <view class="func-title">一键上传</view>
        <view class="func-sub">{{flushing ? '正在上传…' : '把待上传录音提交到平台'}}</view>
      </view>
      <view class="func-arrow">›</view>
    </view>
    <view class="upload-bar" wx:if="{{flushing}}">
      <progress percent="{{progress}}" stroke-width="6" activeColor="#2b6cb0" />
      <view class="upload-text">{{progressText}}</view>
    </view>
    <view class="func-cell" bindtap="goProgress">
      <view class="func-icon func-icon-review">审</view>
      <view class="func-info">
        <view class="func-title">审核进度</view>
        <view class="func-sub" wx:if="{{reviewProgress}}">
          已通过 {{reviewProgress.approved}} · 待审核 {{reviewProgress.pending}} · 需重录 {{reviewProgress.rejected}}
        </view>
        <view class="func-sub" wx:else>点击查看各任务审核进度</view>
      </view>
      <view class="func-arrow">›</view>
    </view>
    <view class="func-cell" bindtap="onExportDuration">
      <view class="func-icon func-icon-export">时</view>
      <view class="func-info">
        <view class="func-title">导出录音时长</view>
        <view class="func-sub">{{exporting ? '正在生成文件…' : '我的录音时长导出为 CSV，可发送保存'}}</view>
      </view>
      <view class="func-arrow">›</view>
    </view>
    <view class="func-cell" bindtap="onShowHelp">
      <view class="func-icon func-icon-help">?</view>
      <view class="func-info">
        <view class="func-title">使用说明</view>
        <view class="func-sub">录音、上传、审核流程介绍</view>
      </view>
      <view class="func-arrow">›</view>
    </view>
  </view>

  <view class="logout-wrap">
    <button class="btn-danger logout-btn" bindtap="onLogout">退出登录</button>
  </view>
</view>
