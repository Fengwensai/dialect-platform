.page {
  padding: 32rpx;
}

.head {
  background: linear-gradient(135deg, #2b6cb0, #4299e1);
  color: #fff;
  border-radius: 20rpx;
  padding: 32rpx 28rpx;
  margin-bottom: 24rpx;
}

.head-title {
  font-size: 34rpx;
  font-weight: 600;
}

.head-sub {
  font-size: 24rpx;
  opacity: 0.9;
  margin-top: 8rpx;
}

.list {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.word {
  background: #fff;
  border-radius: 16rpx;
  padding: 24rpx 28rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.word-main {
  flex: 1;
  padding-right: 20rpx;
}

.word-content {
  font-size: 32rpx;
  font-weight: 600;
  color: #303133;
}

.word-phon {
  font-size: 24rpx;
  color: #909399;
  margin-top: 6rpx;
}

.word-tr {
  margin-top: 12rpx;
  padding: 12rpx 16rpx;
  background: #f7fafc;
  border-radius: 10rpx;
  border-left: 6rpx solid #4299e1;
}

.tr-line {
  font-size: 26rpx;
  color: #2d3748;
  line-height: 1.5;
}

.tr-line + .tr-line {
  margin-top: 6rpx;
}

.tr-tag {
  display: inline-block;
  margin-right: 10rpx;
  padding: 0 10rpx;
  border-radius: 6rpx;
  background: #e8f0fe;
  color: #2b6cb0;
  font-size: 22rpx;
}

.word-side {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.chip {
  font-size: 22rpx;
  padding: 6rpx 18rpx;
  border-radius: 999rpx;
}

.chip-todo {
  background: #f2f3f5;
  color: #909399;
}

.chip-done {
  background: #e6f7ee;
  color: #1f9d55;
}

.chip-pending {
  background: #fef3e2;
  color: #dd6b20;
}

.chip-uploading {
  background: #e8f0fe;
  color: #2b6cb0;
}

.chip-reject {
  background: #fdeaea;
  color: #e53e3e;
}

.word-btn {
  font-size: 26rpx;
  color: #2b6cb0;
  border: 1rpx solid #2b6cb0;
  padding: 8rpx 24rpx;
  border-radius: 999rpx;
}

.empty,
.loading {
  text-align: center;
  color: #909399;
  padding: 80rpx 0;
  font-size: 28rpx;
}
