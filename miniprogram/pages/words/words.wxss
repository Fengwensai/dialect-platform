.page {
  padding: 32rpx;
}

.head {
  background: linear-gradient(135deg, #2b6cb0, #4299e1);
  color: #fff;
  border-radius: 20rpx;
  padding: 32rpx 28rpx;
  margin-bottom: 24rpx;
}

.head-title {
  font-size: 34rpx;
  font-weight: 600;
}

.head-line {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20rpx;
}

.head-title {
  flex: 1;
  min-width: 0;
}

/* 追加领取按钮（head 右上角） */
.claim-btn {
  flex-shrink: 0;
  font-size: 24rpx;
  color: #fff;
  background: rgba(255, 255, 255, 0.22);
  border: 1rpx solid rgba(255, 255, 255, 0.6);
  border-radius: 999rpx;
  padding: 6rpx 28rpx;
  line-height: 1.6;
}

.claim-btn.disabled {
  opacity: 0.55;
}

/* 未录制词条的「退回」链接 */
.word-rel {
  font-size: 22rpx;
  color: #e53e3e;
  margin-left: 8rpx;
  padding: 4rpx 10rpx;
}

/* 领取条数弹窗（自定义 modal，样式同首页绑定弹窗） */
.claim-mask {
  position: fixed;
  left: 0;
  top: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.5);
  z-index: 1000;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 0 56rpx;
  box-sizing: border-box;
}

.claim-dialog {
  width: 100%;
  max-width: 600rpx;
  background: #fff;
  border-radius: 24rpx;
  padding: 48rpx 40rpx 32rpx;
  box-sizing: border-box;
}

.claim-dialog-title {
  font-size: 36rpx;
  font-weight: 700;
  color: #303133;
  text-align: center;
}

.claim-dialog-desc {
  font-size: 24rpx;
  color: #909399;
  line-height: 1.6;
  margin-top: 16rpx;
  text-align: center;
}

.claim-input-wrap {
  margin-top: 36rpx;
  background: #f5f6f7;
  border-radius: 14rpx;
  border: 2rpx solid transparent;
  padding: 0 28rpx;
  transition: border-color 0.2s;
}

.claim-input-wrap.focus {
  border-color: #4299e1;
  background: #fff;
}

.claim-input {
  height: 92rpx;
  font-size: 34rpx;
  font-weight: 600;
  color: #2b6cb0;
}

.claim-input-placeholder {
  color: #a0aec0;
  font-weight: 400;
}

.claim-dialog-actions {
  display: flex;
  gap: 20rpx;
  margin-top: 40rpx;
}

.claim-dialog-btn {
  flex: 1;
  height: 88rpx;
  line-height: 88rpx;
  font-size: 30rpx;
  border-radius: 999rpx;
  margin: 0;
  padding: 0;
}

.claim-dialog-btn::after {
  border: none;
}

.claim-dialog-btn.cancel {
  background: #f0f2f5;
  color: #606266;
}

.claim-dialog-btn.confirm {
  background: linear-gradient(135deg, #2b6cb0, #4299e1);
  color: #fff;
}

.claim-dialog-btn.confirm[disabled] {
  opacity: 0.6;
}

.head-sub {
  font-size: 24rpx;
  opacity: 0.9;
  margin-top: 8rpx;
}

.list {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.word {
  background: #fff;
  border-radius: 16rpx;
  padding: 24rpx 28rpx;
  display: flex;
  align-items: flex-start; /* 原因文字换行变多时，右侧按钮保持顶对齐，不被纵向居中顶乱 */
  justify-content: space-between;
}

.word-main {
  flex: 1;
  min-width: 0; /* 允许长内容收缩换行，不把右侧按钮挤出卡片 */
  padding-right: 20rpx;
}

.word-content {
  font-size: 32rpx;
  font-weight: 600;
  color: #303133;
}

.word-phon {
  font-size: 24rpx;
  color: #909399;
  margin-top: 6rpx;
}

.word-tr {
  margin-top: 12rpx;
  padding: 12rpx 16rpx;
  background: #f7fafc;
  border-radius: 10rpx;
  border-left: 6rpx solid #4299e1;
}

.tr-line {
  font-size: 26rpx;
  color: #2d3748;
  line-height: 1.5;
}

.tr-line + .tr-line {
  margin-top: 6rpx;
}

.tr-tag {
  display: inline-block;
  margin-right: 10rpx;
  padding: 0 10rpx;
  border-radius: 6rpx;
  background: #e8f0fe;
  color: #2b6cb0;
  font-size: 22rpx;
}

.word-side {
  display: flex;
  align-items: center;
  gap: 16rpx;
  flex-shrink: 0; /* 不被长内容挤压 */
  padding-top: 6rpx; /* 顶对齐后与首行词条文字光学对齐 */
}

.chip {
  font-size: 22rpx;
  padding: 6rpx 18rpx;
  border-radius: 999rpx;
}

.chip-todo {
  background: #f2f3f5;
  color: #909399;
}

.chip-done {
  background: #e6f7ee;
  color: #1f9d55;
}

.chip-pending {
  background: #fef3e2;
  color: #dd6b20;
}

.chip-uploading {
  background: #e8f0fe;
  color: #2b6cb0;
}

.chip-reject {
  background: #fdeaea;
  color: #e53e3e;
}

.word-btn {
  font-size: 26rpx;
  color: #2b6cb0;
  border: 1rpx solid #2b6cb0;
  padding: 8rpx 24rpx;
  border-radius: 999rpx;
}

.empty,
.loading {
  text-align: center;
  color: #909399;
  padding: 80rpx 0;
  font-size: 28rpx;
}
